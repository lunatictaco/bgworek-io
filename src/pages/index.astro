---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Bryan Gworek"
  description="Home Page for Bryan"
>

  <section
    id="hero"
    class="relative min-h-svh flex flex-col justify-end px-8 md:px-16 pb-14 pt-28 overflow-hidden"
  >
   
    <img
      src="/images/molecule_cover.png"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover object-center select-none"
      style="opacity: 0"
      id="hero-bg"
      onload="this.style.opacity='1'; this.style.transition='opacity 0.6s ease';"
    />

    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.25) 50%, rgba(10,10,10,0.72) 85%, #0a0a0a 100%);"
    ></div>

    <div class="pointer-events-none absolute inset-0 opacity-[0.04]"
         style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E&quot;); background-size: 256px;">
    </div>

    <div id="hero-content" class="relative max-w-5xl">
      <!-- Role / institution (above name) -->
      <p id="hero-meta" class="text-neutral-400 text-xs tracking-[0.22em] uppercase mb-6 font-medium">
        Biological Graphics and Design&nbsp;&nbsp;·&nbsp&nbsp;Champaign, IL, USA
      </p>

      <!-- Large display name -->
      <h1 id="hero-name" class="text-display font-bold text-neutral-50 leading-none">
        Bryan<br />Gworek
      </h1>

      <!-- Divider + scroll cue -->
      <div id="hero-rule" class="flex items-center gap-6 mt-8">
        <div class="h-px w-16 bg-neutral-700"></div>
        <span class="text-neutral-700 text-xs tracking-[0.3em] uppercase select-none">Scroll</span>
        <div class="h-px flex-1 max-w-xs bg-neutral-700"></div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════
       MAIN CONTENT — numbered scroll sections
  ═══════════════════════════════════════════════════ -->
  <div class="max-w-3xl mx-auto px-8 md:px-6 pb-32">

    <!-- ── 01 About ──────────────────────────────────── -->
    <section id="section-about" class="pt-28 scroll-mt-24">
      <div class="section-divider">
        <span class="section-num">01</span>
        <span class="section-rule"></span>
        <span class="section-label">About</span>
      </div>

      <div class="space-y-5 text-neutral-200 leading-relaxed text-base max-w-prose">
        <p>
          Greetings! I am a Biophysics and Quantitative Biology Doctoral student at the <strong>University of Illinois
          Urbana-Champaign</strong>, working under Dr. Kai Zhang and Dr. Taras Pogorelov.
        </p>
        <p>
          My research focuses on cell signaling and protein/membrane dynamics, with an emphasis on phosphoinositides — a class of signaling lipids critical for membrane-protein interactions.
          These interactions drive key cellular processes, including proliferation, maturation, and development.
        </p>
        <p>
          I work with two key protein systems: <strong>Arc (activity-regulated cytoskeleton-associated protein)</strong>, a peripheral protein that forms viral-like capsids to encapsulate mRNA in neurons,
          and <strong>receptor tyrosine kinases (RTKs)</strong> such as FGFR3 and TrkA, which are central regulators of the same cellular functions governed by phosphoinositide signaling.
        </p>
        <p>
          As a Biophysics doctoral researcher co-advised across computational and experimental laboratories,
          my goal is to bridge theory and experiment by using computational modeling to generate hypotheses and experimental techniques to validate them (and <i>vise versa</i>)!
          This dual approach allows me to investigate biological phenomena with a rigor and perspective that neither discipline offers alone.
        </p>
        <p>
          In addition to my academic work, I enjoy designing and creating graphics for scientific publications, and film photography as a side hobby.
          You can find my various efforts below. Enjoy!
        </p>
      </div>

      <!-- Quick-links row -->
      <div class="flex flex-wrap gap-5 mt-10">
        <a href="/writing" class="inline-flex items-center gap-2 text-sm text-neutral-400 hover:text-accent transition-colors group">
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Publications
        </a>
        <a href="/visuals" class="inline-flex items-center gap-2 text-sm text-neutral-400 hover:text-accent transition-colors group">
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14" />
          </svg>
          Visuals
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 text-sm text-neutral-400 hover:text-accent transition-colors group">
          <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8" />
          </svg>
          Get in touch
        </a>
      </div>
    </section>

    <!-- ── 02 Education ───────────────────────────────── -->
    <section id="section-education" class="pt-24 scroll-mt-24">
      <div class="section-divider">
        <span class="section-num">02</span>
        <span class="section-rule"></span>
        <span class="section-label">Education</span>
      </div>

      <ul class="space-y-8">
        <li class="grid grid-cols-[6rem_1fr] gap-4 items-start">
          <span class="text-xs text-neutral-500 pt-0.5 tabular-nums">2023 – Now</span>
          <div>
            <p class="text-neutral-100 font-medium">Ph.D., Biophysics and Quantitative Biology</p>
            <p class="text-neutral-500 text-sm mt-0.5">University of Illinois Urbana-Champaign</p>
          </div>
        </li>
        <li class="grid grid-cols-[6rem_1fr] gap-4 items-start">
          <span class="text-xs text-neutral-400 pt-0.5 tabular-nums">2018 - 2023</span>
          <div>
            <p class="text-neutral-100 font-medium">B.S., Physics with a dual-minor in Mathematics/Cinema and Television Arts</p>
            <p class="text-neutral-500 text-sm mt-0.5">California State University, Fullerton</p>
          </div>
        </li>
      </ul>
    </section>

    <!-- ── 03 Research ───────────────────────────────── -->
    <section id="section-research" class="pt-24 scroll-mt-24">
      <div class="section-divider">
        <span class="section-num">03</span>
        <span class="section-rule"></span>
        <span class="section-label">Research</span>
      </div>

      <!-- Short research statement -->
      <p class="text-neutral-400 leading-relaxed text-base max-w-prose mb-10">
        Biology is full of surprises... so is the toolkit we use to study it.
        Here are some of the project areas that have kept me busy (or just kept me curious).
      </p>

      <!-- Research interests grid -->
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        {[
          { label: 'Protein Trafficking',       desc: 'Cellular protein recruitment' },
          { label: 'Receptor Tyrosine Kinases',desc: 'Signaling across the membrane' },
          { label: 'Protein-Protein Dimerization',       desc: 'Oligomerization Dynamics' },
          { label: 'Phospholipid Binding Kinetics',        desc: 'Protein affinities at membrane interfaces' },
          { label: 'Optogenetic Cell Death',        desc: 'Light-controlled Necroptosis' },
          { label: 'Free energy barriers',       desc: 'Markov State Modeling, Data Decomposition, Transition Pathways' },
          { label: 'Interaction Free Energies',       desc: 'Changes in Gibbs, Helmholtz, or Entropy that govern cellular processes' },
          { label: 'Minimal In-Cell Modeling',       desc: 'Atomstic Cytoplasm Remodeling' },
          { label: 'Small-Molecule Drug Kinetics',       desc: 'Effects of solvation and vdW dynamics' },
        ].map(item => (
          <li class="flex gap-3 p-4 rounded-lg bg-neutral-900 border border-white/5 hover:border-accent/20 transition-colors">
            <span class="text-accent mt-0.5 text-xs leading-5">▸</span>
            <div>
              <p class="text-neutral-200 text-sm font-medium">{item.label}</p>
              <p class="text-neutral-400 text-xs mt-0.5">{item.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- ── 04 Methods & Skills ───────────────────────── -->
    <section id="section-methods" class="pt-24 scroll-mt-24">
      <div class="section-divider">
        <span class="section-num">04</span>
        <span class="section-rule"></span>
        <span class="section-label">Methods &amp; Skills</span>
      </div>

      <div class="space-y-10">

        <!-- Computational Biophysics -->
        <div>
          <h3 class="text-neutral-100 font-semibold text-sm mb-4">Computational Biophysics</h3>
          <dl class="space-y-2.5">
            {[
              { label: 'Molecular Dynamics',             value: 'NAMD, GROMACS, AMBER, OpenMM, MARTINI' },
              { label: 'Docking',                        value: 'HADDOCK & AutoDock' },
              { label: 'Scientific / ML Analysis',       value: 'MDAnalysis, MDTraj, VMD, PyTorch, TensorFlow' },
              { label: 'Protein Prediction & Bioinformatics', value: 'DESeq2, edgeR, AlphaFold2/3, ESMFold, OpenFold' },
              { label: 'Visualization',                  value: 'Blender, PyMOL, VMD, ChimeraX, Fiji (ImageJ)' },
              { label: 'Enhanced Sampling',              value: 'Plumed & WESTPA2' },
            ].map(row => (
              <div class="grid grid-cols-[13rem_1fr] gap-3 text-sm">
                <dt class="text-accent/100 font-medium shrink-0">{row.label}</dt>
                <dd class="text-neutral-300">{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        <!-- Computer Administration -->
        <div>
          <h3 class="text-neutral-100 font-semibold text-sm mb-4">Computer Administration</h3>
          <p class="text-neutral-300 text-sm leading-relaxed">
            Linux server management/administration (Ubuntu/Arch), SLURM Configuration/Setup, Docker Management, HPC cluster management (DGX Ampere/Grace Hopper)
          </p>
        </div>

        <!-- Programming Languages -->
        <div>
          <h3 class="text-neutral-100 font-semibold text-sm mb-4">Programming Languages</h3>
          <div class="flex flex-wrap gap-2">
            {[
              { lang: 'Python',  level: 'Expert' },
              { lang: 'Tcl',     level: 'Expert' },
              { lang: 'Bash',    level: 'Expert' },
              { lang: 'C++',     level: 'Proficient' },
              { lang: 'R',       level: 'Proficient' },
              { lang: 'HTML/CSS',       level: 'Proficient' },
              { lang: 'Perl',       level: 'Novice' }, 
              { lang: 'Julia',   level: 'Novice' },
            ].map(item => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs
                            bg-neutral-900 border border-white/6
                            hover:border-accent/60 transition-colors cursor-default">
                <span class="text-section">{item.lang}</span>
                <span class="text-neutral-300">{item.level}</span>
              </span>
            ))}
          </div>
        </div>

        <!-- Relevant Coursework -->
        <div>
          <h3 class="text-neutral-100 font-semibold text-sm mb-4">Relevant Coursework</h3>
          <p class="text-neutral-300 text-sm leading-relaxed">
            Graduate Machine Learning for Bioinformatics (CS 582), Graduate Statistical Thermodynamics (CHEM 544),
            Graduate Scientific Writing (MCB 540), Physical Biochemistry (MCB 446)
          </p>
        </div>

        <!-- Experimental Techniques -->
        <div>
          <h3 class="text-neutral-100 font-semibold text-sm mb-4">Experimental Techniques</h3>
          <dl class="space-y-2.5">
            {[
              { label: 'Microscopy',          value: 'TIRF, epifluorescence/live-cell imaging, confocal, MINFLUX super resolution, Electron Microscopy (TEM)' },
              { label: 'Molecular Biology',   value: 'PCR, qRT-PCR, molecular cloning, western blot, SDS/Agarose gels, RNA purification, RNA-seq prep, transfection, transduction' },
              { label: 'Cell Biology',        value: 'Cell culture, primary neuron culture, lentiviral culture, AAV, cell death assays' },
              { label: 'Protein Biochemistry',value: 'Protein purification, size-exclusion chromatography (SEC), nanodiscs, extracellular vesicle prep, surface plasmon resonance (SPR), Bio-Layer Interferometry (BLI)' },
            ].map(row => (
              <div class="grid grid-cols-[13rem_1fr] gap-3 text-sm">
                <dt class="text-accent/100 font-medium shrink-0">{row.label}</dt>
                <dd class="text-neutral-300">{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>

      </div>
    </section>

  </div>
</BaseLayout>

<script>
  import { animate, inView } from 'motion';

  // Hero staggered reveal
  animate('#hero-meta',    { opacity: [0, 1], y: [6,  0] }, { duration: 0.7, delay: 0.1, easing: 'ease-out' });
  animate('#hero-name',    { opacity: [0, 1], y: [20, 0] }, { duration: 0.8, delay: 0.25, easing: [0.16, 1, 0.3, 1] });
  animate('#hero-rule',    { opacity: [0, 1] },              { duration: 0.6, delay: 0.7,  easing: 'ease-out' });

  // Scroll-triggered section reveals
  const sections = ['#section-about', '#section-education', '#section-research', '#section-methods'];

  sections.forEach(id => {
    inView(id, (el) => {
      animate(el, { opacity: [0, 1], y: [18, 0] }, { duration: 0.65, easing: [0.16, 1, 0.3, 1] });
    }, { margin: '-80px 0px' });
  });

  // Stagger research interest cards on scroll
  inView('#section-research ul', () => {
    const cards = document.querySelectorAll('#section-research li');
    cards.forEach((card, i) => {
      animate(card, { opacity: [0, 1], y: [12, 0] }, {
        duration: 0.45,
        delay: i * 0.07,
        easing: 'ease-out',
      });
    });
  }, { margin: '-60px 0px' });
</script>
