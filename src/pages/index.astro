---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allVisuals = await getCollection('visuals');
const scientific = allVisuals
  .filter(v => v.data.category === 'scientific')
  .sort((a, b) => a.data.order - b.data.order);
const film = allVisuals
  .filter(v => v.data.category === 'film')
  .sort((a, b) => a.data.order - b.data.order);

// The wide membrane is the hero band; the rest fill the featured grid.
const HERO_IMAGE = '/images/scientific/complex_membrane_wide.webp';
const featured = scientific.filter(v => v.data.image !== HERO_IMAGE).slice(0, 7);

// Editorial rhythm: lg + sm / md + md / md + md / wide
const slots = ['is-lg', 'is-sm', 'is-md', 'is-md', 'is-md', 'is-md', 'is-wide'];

const filmCover = film[0];
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title="Bryan Gworek — Scientific Illustration"
  description="Scientific illustrations of membranes, proteins and the molecules between them, by biophysicist Bryan Gworek."
  image="/images/scientific/thumbs/transmembrane.webp"
>

  <!-- ══ Hero: the art first ══════════════════════════ -->
  <section id="hero" class="relative overflow-hidden px-6 md:px-16 pt-24 pb-14">
    <div class="-mx-6 md:-mx-16">
      <img
        src={HERO_IMAGE}
        alt="A wide membrane slab rendered in cream, coral, ochre, teal and wine"
        width="3960"
        height="1320"
        fetchpriority="high"
        class="float-slow w-full h-auto select-none"
        draggable="false"
      />
    </div>

    <div class="reveal is-in max-w-6xl mx-auto mt-10 grid gap-8 md:grid-cols-[1.4fr_1fr] md:items-end">
      <div>
        <p class="eyebrow">Scientific illustration · Biophysics<span class="hidden sm:inline"> · Champaign, IL</span></p>
        <h1 class="mt-4 font-display font-bold text-display text-ink">Bryan<br />Gworek</h1>
      </div>
      <div class="md:pb-3">
        <p class="text-lg leading-[30px] font-light text-ink-muted max-w-[34ch] mb-5">
          I render membranes, proteins and the molecules between them, with Blender and Molecular Nodes.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/visuals/scientific" class="btn btn-primary">
            View the work
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </a>
          <a href="/about" class="btn btn-ghost">About me</a>
        </div>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 pb-8">

    <!-- ── 01 Selected illustrations ─────────────────── -->
    <section id="section-work" class="pt-16 scroll-mt-24">
      <div class="section-divider reveal">
        <span class="section-num">01</span>
        <span class="section-rule"></span>
        <span class="section-label">Selected illustrations</span>
      </div>

      <div class="featured">
        {featured.map((item, i) => (
          <a
            href="/visuals/scientific"
            class={`plate reveal ${slots[i] ?? 'is-md'}`}
            style={`--d:${(i % 2) * 120}ms`}
          >
            <div class="plate-frame">
              <img
                src={item.data.thumbnail ?? item.data.image}
                alt={item.data.title}
                loading="lazy"
                draggable="false"
                class="select-none"
              />
            </div>
            <div class="flex justify-between items-baseline gap-4">
              <div>
                <p class="plate-title">{item.data.title}</p>
                <p class="plate-caption">{item.data.description}</p>
              </div>
              <span class="plate-index">{pad(i + 1)}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ── 02 About ──────────────────────────────────── -->
    <section id="section-about" class="pt-24 scroll-mt-24">
      <div class="section-divider reveal">
        <span class="section-num">02</span>
        <span class="section-rule"></span>
        <span class="section-label">About</span>
      </div>

      <div class="reveal grid gap-8 md:grid-cols-[1fr_1.4fr] items-start">
        <p class="text-ink text-xl md:text-[22px] leading-[34px] font-light">
          Biophysics PhD student at the University of Illinois Urbana-Champaign, studying how proteins meet membranes.
        </p>
        <div>
          <p class="text-ink-muted leading-relaxed max-w-prose">
            My research looks at phosphoinositide signaling with Arc and receptor tyrosine kinases, bridging
            computational models and the bench. The illustrations come out of that work: each one starts as a
            simulation and ends as a picture.
          </p>
          <div class="flex flex-wrap gap-5 mt-6">
            <a href="/about" class="quick-link">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg>
              Full CV &amp; research
            </a>
            <a href="/writing" class="quick-link">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg>
              Publications
            </a>
            <a href="/contact" class="quick-link">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6"/></svg>
              Get in touch
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── 03 Elsewhere ──────────────────────────────── -->
    <section id="section-elsewhere" class="pt-24 scroll-mt-24">
      <div class="section-divider reveal">
        <span class="section-num">03</span>
        <span class="section-rule"></span>
        <span class="section-label">Elsewhere</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <a href="/visuals/scientific" class="cat-card reveal">
          <div class="cat-img aspect-video">
            <img src="/images/scientific/thumbs/peripheral.webp" alt="" loading="lazy" />
          </div>
          <div class="p-5 flex items-center justify-between">
            <div>
              <h3 class="cat-title">All scientific work</h3>
              <p class="text-xs text-ink-faint mt-1">Concepts and ideas</p>
            </div>
            <span class="text-xs text-accent tabular-nums">{pad(scientific.length)}</span>
          </div>
        </a>

        <a href="/visuals/film" class="cat-card reveal" style="--d:120ms">
          <div class="cat-img aspect-video">
            {filmCover && (
              <img src={filmCover.data.thumbnail ?? filmCover.data.image} alt="" loading="lazy" />
            )}
          </div>
          <div class="p-5 flex items-center justify-between">
            <div>
              <h3 class="cat-title">Film photography</h3>
              <p class="text-xs text-ink-faint mt-1">Fun art with analog film</p>
            </div>
            <span class="text-xs text-accent tabular-nums">{pad(film.length)}</span>
          </div>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
