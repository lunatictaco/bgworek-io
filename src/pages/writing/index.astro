---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import { getCollection } from 'astro:content';

const allPubs = await getCollection('publications');
const publications = allPubs.sort((a, b) => b.data.year - a.data.year);

const byYear = publications.reduce((acc, pub) => {
  const y = pub.data.year;
  if (!acc[y]) acc[y] = [];
  acc[y].push(pub);
  return acc;
}, {} as Record<number, typeof publications>);

const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
---

<BaseLayout
  title="Publications — Bryan Gworek"
  description="Academic publications and research papers"
>
  <div class="max-w-3xl mx-auto px-8 md:px-6 pt-36 pb-32">

    <!-- Page header -->
    <header class="mb-16 reveal is-in" id="writing-header">
      <div class="page-divider">
        <span class="pd-rule"></span>
        <h1 class="pd-label">Publications</h1>
        <span class="pd-rule"></span>
      </div>
      <p class="text-ink-muted text-base leading-relaxed max-w-prose">
        Peer-reviewed publications and research communications.
        <sup class="text-ink-muted">#</sup><span class="text-ink-muted ml-1">denotes equal contribution.</span>
      </p>
    </header>

    <!-- Publications grouped by year -->
    <div id="publications-list" class="space-y-12">
      {years.map(year => (
        <section class="reveal">
          <h2 class="text-xs font-mono text-accent tracking-widest mb-1 uppercase tabular-nums">{year}</h2>
          <div class="border-t border-line">
            {byYear[year].map(pub => (
              <PublicationCard
                title={pub.data.title}
                authors={pub.data.authors}
                journal={pub.data.journal}
                year={pub.data.year}
                volume={pub.data.volume}
                pages={pub.data.pages}
                doi={pub.data.doi}
                link={pub.data.link}
                notes={pub.data.notes}
                highlightAuthor={pub.data.highlight_author}
              />
            ))}
          </div>
        </section>
      ))}
    </div>

  </div>
</BaseLayout>
