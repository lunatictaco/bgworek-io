---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found — Bryan Gworek">
  <div class="max-w-3xl mx-auto px-8 py-40 text-center">
    <p class="font-mono text-7xl font-bold text-neutral-900 mb-6 select-none">404</p>
    <h1 class="font-bold text-2xl text-neutral-200 mb-3 tracking-tight">Page not found</h1>
    <p class="text-neutral-500 mb-10">The page you're looking for doesn't exist.</p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-white/8
             text-sm text-neutral-400 hover:text-accent hover:border-accent/30 transition-all"
    >
      ← Go home
    </a>
  </div>
</BaseLayout>
