---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found — Bryan Gworek">
  <div class="max-w-3xl mx-auto px-8 py-40 text-center">
    <p class="font-display text-8xl font-bold text-accent mb-6 select-none">404</p>
    <h1 class="font-bold text-2xl text-ink mb-3 tracking-tight">Page not found</h1>
    <p class="text-ink-faint mb-10">The page you're looking for doesn't exist.</p>
    <a
      href="/"
      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-line-strong/60
             text-sm text-ink-muted hover:text-accent hover:border-accent/30 transition-all"
    >
      ← Go home
    </a>
  </div>
</BaseLayout>
