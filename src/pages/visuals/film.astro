---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import { getCollection } from 'astro:content';

const allVisuals = await getCollection('visuals');
const images = allVisuals
  .filter(v => v.data.category === 'film')
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Film Photography — Bryan Gworek" description="Photographs shot on analog film.">
  <div class="max-w-5xl mx-auto px-8 md:px-6 pt-36 pb-32">

    <!-- Breadcrumb -->
    <nav class="mb-10 flex items-center gap-2 text-xs text-neutral-600" aria-label="Breadcrumb">
      <a href="/visuals" class="hover:text-accent transition-colors">Visuals</a>
      <span class="text-neutral-700">/</span>
      <span class="text-neutral-400">Film Photography</span>
    </nav>

    <header class="mb-12" id="film-header">
      <div class="page-divider">
        <span class="pd-rule"></span>
        <span class="pd-label">Film Photography</span>
        <span class="pd-rule"></span>
      </div>
      <h1 class="font-bold text-neutral-50 text-3xl md:text-4xl tracking-tight">Film Photography</h1>
      <p class="mt-3 text-neutral-500 text-sm max-w-prose">
        Photographs shot on analog film. Click any image to view at full size.
      </p>
    </header>

    {images.length > 0 ? (
      <GalleryGrid id="film-gallery">
        {images.map(img => (
          <GalleryImage
            src={img.data.image}
            thumbnail={img.data.thumbnail}
            title={img.data.title}
            description={img.data.description}
            width={img.data.width}
            height={img.data.height}
          />
        ))}
      </GalleryGrid>
    ) : (
      <div class="text-center py-28 text-neutral-600">
        <svg class="w-10 h-10 mx-auto mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"
            d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"
            d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
        </svg>
        <p class="text-neutral-500 font-medium">No photos yet</p>
        <p class="text-sm mt-2 text-neutral-700">
          Add images to <code class="bg-neutral-900 px-1.5 py-0.5 rounded text-xs">public/images/film/</code>
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  import { animate } from 'motion';
  animate('#film-header', { opacity: [0, 1], y: [10, 0] }, { duration: 0.5, easing: 'ease-out' });
</script>
