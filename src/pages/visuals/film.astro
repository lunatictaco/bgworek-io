---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import GalleryImage from '../../components/GalleryImage.astro';
import { getCollection } from 'astro:content';

const allVisuals = await getCollection('visuals');
const images = allVisuals
  .filter(v => v.data.category === 'film')
  .sort((a, b) => a.data.order - b.data.order);

// ── Subsections ────────────────────────────────────────────────────────────────
// Ordered newest → oldest. The `name` must exactly match the `subsection` field
// in your JSON files. Sections with no matching images are automatically hidden.
const sections: { name: string; description: string }[] = [
  { name: 'Thailand 2026',                              description: '' },
  { name: 'Hanoi - Vietnam 2026',                       description: '' },
  { name: 'Zurich - Les Diablerets - Switzerland 2025', description: '' },
  { name: 'Hawaii 2023',                                description: '' },
  { name: 'Santa Barbara 2023',                         description: '' },
  { name: 'Santa Ana 2023',                             description: '' },
  { name: 'Joshua Tree 2020-2023',                      description: '' },
  { name: 'New Hampshire - New York - Boston 2022',     description: '' },
  { name: 'San Francisco 2021',                         description: '' },
  { name: 'Old Self Portraits 2020',                    description: '' },
  { name: 'San Francisco 2020',                         description: '' },
  { name: 'London - United Kingdom 2019',               description: '' },
  { name: 'Big Sur 2019',                               description: '' },
  { name: 'Hunington Gardens 2019',                     description: '' },
];

// Group images by subsection key
const bySection = new Map<string, typeof images>();
for (const img of images) {
  const key = img.data.subsection ?? '';
  if (!bySection.has(key)) bySection.set(key, []);
  bySection.get(key)!.push(img);
}
const ungrouped = bySection.get('') ?? [];
---

<BaseLayout title="Film Photography — Bryan Gworek" description="Photographs shot on analog film.">
  <div class="max-w-5xl mx-auto px-8 md:px-6 pt-36 pb-32">

    <!-- Breadcrumb -->
    <nav class="mb-10 flex items-center gap-2 text-xs text-neutral-600" aria-label="Breadcrumb">
      <a href="/visuals" class="hover:text-accent transition-colors">Visuals</a>
      <span class="text-neutral-700">/</span>
      <span class="text-neutral-400">Film Photography</span>
    </nav>

    <header class="mb-12" id="film-header">
      <div class="page-divider">
        <span class="pd-rule"></span>
        <span class="pd-label">Film</span>
        <span class="pd-rule"></span>
      </div>
      <!-- Film Toolkit -->
        <div>
          <h3 class="text-neutral-100 font-semibold text-sm mb-4">Film Toolkit</h3>
          <dl class="space-y-2.5">
            {[
              { label: 'Restored Cameras',          value: 'Zeiss Ikon Super Ikonta 530/2 (I have 3 variants of these for some reason), Voigtländer Bessa 66 Folder, Kodak Brownie No. 2/3, Nikon F2, and many more...' },
              { label: 'My Favorites',   value: 'Mamiya Press Super 23, Olympus OM-1/OM-2, Olympus XA' },
              { label: 'Lenses',        value: 'Mamiya-Sekor 100mm ƒ/3.5, Vivitar 35-85mm ƒ/2.8, Olympus D-Zuiko 35mm ƒ/2.8, Olympus OM Zukio 28mm ƒ/2.8, Zeiss Tessar 10.5cm ƒ/3.8, Voigtar 75mm ƒ/3.5' },
              { label: 'Film',value: 'Cinestill 800T, Kodak Ektachrome E100, Kodak Porta 400, Kodak Portra 100, Kodak Ektar 100, Ilford FP4 Plus, Ilford HP5+ 400, Ilford Delta 100, Fuji Pro 400H' },
            ].map(row => (
              <div class="grid grid-cols-[13rem_1fr] gap-3 text-sm">
                <dt class="text-accent/100 font-medium shrink-0">{row.label}</dt>
                <dd class="text-neutral-300">{row.value}</dd>
              </div>
            ))}
          </dl>
        </div>
    </header>

    {images.length > 0 ? (
      <>
        {/* Images with no subsection appear first, ungrouped */}
        {ungrouped.length > 0 && (
          <GalleryGrid id="film-gallery-main">
            {ungrouped.map(img => (
              <GalleryImage
                src={img.data.image}
                thumbnail={img.data.thumbnail}
                title={img.data.title}
                description={img.data.description}
                width={img.data.width}
                height={img.data.height}
              />
            ))}
          </GalleryGrid>
        )}

        {/* Named subsections */}
        {sections.map((section, i) => {
          const sectionImages = bySection.get(section.name) ?? [];
          if (sectionImages.length === 0) return null;
          return (
            <section class={ungrouped.length > 0 || i > 0 ? 'mt-20' : ''}>
              <div class="mb-8">
                <h2 class="text-lg font-semibold text-neutral-200 tracking-tight">{section.name}</h2>
                {section.description && <p class="mt-1 text-sm text-neutral-500 max-w-prose">{section.description}</p>}
              </div>
              <GalleryGrid id={`film-gallery-${i}`}>
                {sectionImages.map(img => (
                  <GalleryImage
                    src={img.data.image}
                    thumbnail={img.data.thumbnail}
                    title={img.data.title}
                    description={img.data.description}
                    width={img.data.width}
                    height={img.data.height}
                  />
                ))}
              </GalleryGrid>
            </section>
          );
        })}
      </>
    ) : (
      <div class="text-center py-28 text-neutral-600">
        <svg class="w-10 h-10 mx-auto mb-4 opacity-30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"
            d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"
            d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
        </svg>
        <p class="text-neutral-500 font-medium">No photos yet</p>
        <p class="text-sm mt-2 text-neutral-700">
          Add images to <code class="bg-neutral-900 px-1.5 py-0.5 rounded text-xs">public/images/film/</code>
        </p>
      </div>
    )}
  </div>
</BaseLayout>

<script>
  import { animate } from 'motion';
  animate('#film-header', { opacity: [0, 1], y: [10, 0] }, { duration: 0.5, easing: 'ease-out' });
</script>
