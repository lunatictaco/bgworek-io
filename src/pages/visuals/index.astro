---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allVisuals = await getCollection('visuals');
const scientificCount = allVisuals.filter(v => v.data.category === 'scientific').length;
const filmCount       = allVisuals.filter(v => v.data.category === 'film').length;

const scientificPreview = allVisuals
  .filter(v => v.data.category === 'scientific')
  .sort((a, b) => a.data.order - b.data.order)[0];
const filmPreview = allVisuals
  .filter(v => v.data.category === 'film')
  .sort((a, b) => a.data.order - b.data.order)[0];
---

<BaseLayout
  title="Visuals — Bryan Gworek"
  description="Scientific imagery and film photography by Bryan Gworek."
>
  <div class="max-w-3xl mx-auto px-8 md:px-6 pt-36 pb-32">

    <!-- Page header -->
    <header class="mb-16 reveal is-in" id="visuals-header">
      <div class="page-divider">
        <span class="pd-rule"></span>
        <span class="pd-label">Pick one!</span>
        <span class="pd-rule"></span>
      </div>
    </header>

    <!-- Category cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="category-cards">

      <!-- Scientific Work -->
      <a
        href="/visuals/scientific"
        class="reveal group block rounded-xl overflow-hidden border border-line hover:border-accent
               transition-all duration-300 hover:shadow-lg "
      >
        <div class="aspect-[4/3] overflow-hidden bg-surface-raised">
          {scientificPreview ? (
            <img
              src={scientificPreview.data.image}
              alt="Scientific work"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 "
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center">
              <svg class="w-10 h-10 text-ink-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"
                  d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23-.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
              </svg>
            </div>
          )}
        </div>
        <div class="p-5 bg-surface-raised">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-ink font-medium group-hover:text-accent transition-colors">
                Scientific Work
              </h2>
              <p class="text-xs text-ink-faint mt-1">Microscopy &amp; Renderings</p>
            </div>
            <span class="text-xs font-mono text-ink-faint">{String(scientificCount).padStart(2, '0')}</span>
          </div>
        </div>
      </a>

      <!-- Film Photography -->
      <a
        href="/visuals/film"
        class="reveal group block rounded-xl overflow-hidden border border-line hover:border-accent
               transition-all duration-300 hover:shadow-lg "
      >
        <div class="aspect-[4/3] overflow-hidden bg-surface-overlay">
          {filmPreview ? (
            <img
              src={filmPreview.data.image}
              alt="Film photography"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 "
            />
          ) : (
            <div class="w-full h-full flex items-center justify-center">
              <svg class="w-10 h-10 text-ink-faint" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"
                  d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2"
                  d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
              </svg>
            </div>
          )}
        </div>
        <div class="p-5 bg-surface-raised">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-ink font-medium group-hover:text-accent transition-colors">
                Film Photography
              </h2>
              <p class="text-xs text-ink-faint mt-1">Fun art with analog film</p>
            </div>
            <span class="text-xs font-mono text-ink-muted">{String(filmCount).padStart(2, '0')}</span>
          </div>
        </div>
      </a>

    </div>
  </div>
</BaseLayout>
