---
interface Props {
  src: string;
  title: string;
  description: string;
  width?: number;
  height?: number;
  thumbnail?: string;
  /** Show the hover chip and lightbox caption (off for scientific work for now) */
  showCaption?: boolean;
}

const { src, title, description, width = 800, height = 600, thumbnail, showCaption = true } = Astro.props;
const caption = showCaption ? description : '';
const thumbSrc = thumbnail ?? src;
---

<figure class="gallery-item reveal break-inside-avoid overflow-hidden rounded-lg group relative cursor-zoom-in bg-surface-raised" style={`aspect-ratio: ${width} / ${height}`}>
  <a
    class="gallery-anchor block overflow-hidden rounded-lg"
    href={src}
    data-pswp-width={width}
    data-pswp-height={height}
    target="_blank"
    rel="noopener"
  >
    <img
      src={thumbSrc}
      alt={title}
      width={width}
      height={height}
      data-caption={caption || undefined}
      loading="lazy"
      draggable="false"
      class="w-full h-auto transition-transform duration-500 group-hover:scale-[1.03] select-none"
    />

    <!-- Image protection overlay: blocks drag and removes "Save Image As" from right-click -->
    <div class="image-shield absolute inset-0 z-[1]" aria-hidden="true"></div>

    <!-- Hover caption chip (scrim + ink, replaces the old black gradient).
         Skipped when there's no description: film titles are frame numbers. -->
    {caption && <div
      class="z-[2] absolute left-2 right-2 bottom-2 px-3 py-2.5 rounded-md
             text-ink text-xs font-medium leading-snug tracking-wide
             opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0
             transition-all duration-300"
      style="background: var(--scrim)"
    >
      <p class="line-clamp-2">{title}</p>
    </div>}
  </a>
</figure>
