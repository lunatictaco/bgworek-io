---
interface Props {
  src: string;
  title: string;
  description: string;
  width?: number;
  height?: number;
  thumbnail?: string;
}

const { src, title, description, width = 800, height = 600, thumbnail } = Astro.props;
const thumbSrc = thumbnail ?? src;
---

<figure class="gallery-item break-inside-avoid overflow-hidden rounded-lg group relative cursor-pointer" style={`aspect-ratio: ${width} / ${height}`}>
  <a
    class="gallery-anchor block overflow-hidden rounded-lg"
    href={src}
    data-pswp-width={width}
    data-pswp-height={height}
    target="_blank"
    rel="noopener"
  >
    <img
      src={thumbSrc}
      alt={title}
      width={width}
      height={height}
      data-caption={description}
      loading="lazy"
      draggable="false"
      class="w-full h-auto transition-transform duration-500 group-hover:scale-[1.03] opacity-90 group-hover:opacity-100 select-none"
    />

    <!-- Image protection overlay: blocks drag and removes "Save Image As" from right-click -->
    <div class="image-shield absolute inset-0 z-[1]" aria-hidden="true"></div>

    <!-- Hover caption overlay -->
    <div class="z-[2]
      absolute inset-0
      bg-gradient-to-t from-black/70 via-black/10 to-transparent
      opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-lg
      flex items-end p-4
    ">
      <p class="text-white text-xs font-medium leading-snug line-clamp-2 tracking-wide">{title}</p>
    </div>
  </a>
</figure>
