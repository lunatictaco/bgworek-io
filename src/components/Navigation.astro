---
const { pathname } = Astro.url;

// Work leads; Contact lives in About and the footer.
const links = [
  { href: '/visuals/scientific', label: 'Work',    match: ['/visuals/scientific', '/visuals'] },
  { href: '/visuals/film',       label: 'Film',    match: ['/visuals/film'] },
  { href: '/writing',            label: 'Writing', match: ['/writing'] },
  { href: '/about',              label: 'About',   match: ['/about', '/contact'] },
];

function isActive(match: string[]) {
  // /visuals/film must not also light up Work
  if (match.includes('/visuals') && pathname.startsWith('/visuals/film')) return false;
  return match.some((m) => pathname === m || pathname.startsWith(m + '/'));
}
---

<header id="site-nav" class="fixed top-0 left-0 right-0 z-50">
  <nav class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between" aria-label="Main">

    <!-- Wordmark -->
    <a
      href="/"
      class="inline-flex items-center gap-2.5 text-xs font-medium tracking-[0.18em] uppercase text-ink hover:text-accent transition-colors duration-200"
    >
      <img src="/favicon.svg" alt="" width="22" height="22" class="w-[22px] h-[22px]" />
      Bryan Gworek
    </a>

    <!-- ── Desktop links ──────────────────────────── -->
    <ul class="hidden md:flex items-center gap-8 text-sm">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class={`tracking-wide transition-colors duration-200 hover:text-accent ${isActive(l.match) ? 'text-accent' : 'text-ink-muted'}`}
            aria-current={isActive(l.match) ? 'page' : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- ── Mobile hamburger ───────────────────────── -->
    <button
      id="menu-toggle"
      class="md:hidden p-2 -mr-2 text-ink-muted hover:text-accent transition-colors"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg id="icon-open" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>

  <!-- ── Mobile menu drawer ─────────────────────────── -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-line bg-surface/95 backdrop-blur-md">
    <ul class="max-w-6xl mx-auto px-6 py-4 flex flex-col gap-1 text-sm">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class={`block py-2.5 transition-colors hover:text-accent ${isActive(l.match) ? 'text-accent' : 'text-ink-muted'}`}
            aria-current={isActive(l.match) ? 'page' : undefined}
          >
            {l.label}
          </a>
        </li>
      ))}
      <li>
        <a href="/contact" class={`block py-2.5 transition-colors hover:text-accent ${pathname.startsWith('/contact') ? 'text-accent' : 'text-ink-muted'}`}>
          Contact
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  import { animate } from 'motion';

  let navAbort: AbortController | null = null;

  function initNav() {
    // Cancel all listeners from the previous init call
    navAbort?.abort();
    navAbort = new AbortController();
    const { signal } = navAbort;

    // ── Scroll: solid bar once past the top (always on inner pages) ──
    const nav = document.getElementById('site-nav');
    const isHome = window.location.pathname === '/';
    function updateScrollState() {
      nav?.classList.toggle('nav-scrolled', !isHome || window.scrollY > 60);
    }
    updateScrollState();
    window.addEventListener('scroll', updateScrollState, { passive: true, signal });

    // ── Mobile: hamburger toggle ───────────────────────
    const toggle    = document.getElementById('menu-toggle');
    const menu      = document.getElementById('mobile-menu') as HTMLElement | null;
    const iconOpen  = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');

    function openMenu() {
      if (!menu) return;
      menu.classList.remove('hidden');
      animate(menu, { opacity: [0, 1] }, { duration: 0.2, easing: 'ease-out' });
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      toggle?.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      if (!menu) return;
      animate(menu, { opacity: [1, 0] }, { duration: 0.15, easing: 'ease-in' }).finished.then(() => {
        menu.classList.add('hidden');
        // Reset opacity so next open fades correctly
        menu.style.opacity = '';
      });
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    }

    toggle?.addEventListener('click', () => {
      if (menu?.classList.contains('hidden')) openMenu();
      else closeMenu();
    }, { signal });

    // Close mobile menu on nav link click
    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => closeMenu(), { signal });
    });
  }

  document.addEventListener('astro:page-load', initNav);
</script>
