---
interface Props {
  title: string;
  authors: string;
  journal: string;
  year: number;
  volume?: string;
  pages?: string;
  doi?: string;
  link?: string;
  notes?: string;
  highlightAuthor?: string;
}

const { title, authors, journal, year, volume, pages, doi, link, notes, highlightAuthor } = Astro.props;

function highlightAuthors(authorStr: string, highlight?: string): string {
  if (!highlight) return authorStr;
  const name = highlight.replace(/#/g, '').trim();
  const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  return authorStr.replace(
    new RegExp(`(${escaped}[#]?)`, 'g'),
    '<strong class="text-accent font-semibold">$1</strong>'
  );
}

const formattedAuthors = highlightAuthors(authors, highlightAuthor);
---

<article class="publication-card group py-7 border-b border-white/6 last:border-0">
  <div class="space-y-2.5">
    <!-- Title -->
    {link ? (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="block font-medium text-neutral-200 text-base leading-snug hover:text-accent transition-colors"
      >
        {title}
        <svg
          class="inline-block ml-1.5 w-3.5 h-3.5 opacity-0 group-hover:opacity-60 transition-opacity -mt-0.5"
          fill="none" stroke="currentColor" viewBox="0 0 24 24"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    ) : (
      <p class="font-medium text-neutral-100 text-base leading-snug">{title}</p>
    )}

    <!-- Authors -->
    <p class="text-sm text-neutral-400 leading-relaxed" set:html={formattedAuthors} />

    <!-- Journal / Year -->
    <p class="text-sm text-neutral-300">
      <em class="not-italic text-neutral-300">{journal}</em>
      {volume && <span class="text-neutral-400">,&nbsp;{volume}</span>}
      {pages && <span class="text-neutral-400">:{pages}</span>}
      <span class="mx-2 text-neutral-400">·</span>
      <span class="text-neutral-400">{year}</span>
    </p>

    <!-- DOI + notes -->
    <div class="flex flex-wrap items-center gap-4 text-xs">
      {doi && (
        <a
          href={link || `https://doi.org/${doi}`}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-neutral-400 hover:text-accent transition-colors"
        >
          doi:{doi}
        </a>
      )}
      {notes && (
        <span class="text-neutral-600 italic">{notes}</span>
      )}
    </div>
  </div>
</article>
